{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://questor.local/protocol/openai_compat.schema.json",
  "title": "Questor OpenAI-compat wire contract (projection output + error)",
  "description": "Single source of truth for the OpenAI-compatible WIRE our projection adapter emits (ADR-0043). INDEPENDENT from questor's own event contract (protocol/event.schema.json): the OpenAI shape never leaks into the event envelope, and questor event `v` is unaffected. Drift-gated by scripts/check_openai_compat_schema.py. x_questor is our namespaced extension slot for questor-only data; standard OpenAI fields must not be polluted by it.",
  "type": "object",
  "$defs": {
    "chat_completion_chunk": {
      "type": "object",
      "required": ["id", "object", "created", "model", "choices"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "object": { "const": "chat.completion.chunk" },
        "created": { "type": "integer", "minimum": 0 },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["index", "delta", "finish_reason"],
            "additionalProperties": false,
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "delta": { "type": "object" },
              "finish_reason": { "type": ["string", "null"], "enum": ["stop", "length", "tool_calls", null] }
            }
          }
        },
        "x_questor": { "type": "object" }
      }
    },
    "error_object": {
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": ["type", "message", "code"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "maxLength": 128 },
            "message": { "type": "string", "maxLength": 8192 },
            "param": { "type": ["string", "null"], "maxLength": 128 },
            "code": { "type": "string", "maxLength": 128 }
          }
        }
      }
    }
  }
}
