{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://questor.local/protocol/event.schema.json",
  "title": "Questor external event projection (v1)",
  "description": "Single source of truth for the external event envelope (HARD C6/C15; design/02). Additive-only: new `type` values and optional `data` fields are allowed; existing semantics must not change. Per-type `data` is a strict whitelist (additionalProperties:false, bounded strings). CI --check prevents drift against questor.contracts.events.EventType and requires a $defs branch for every type.",
  "type": "object",
  "required": ["v", "seq", "run_id", "type", "ts", "data"],
  "additionalProperties": false,
  "properties": {
    "v": { "type": "integer", "minimum": 1, "description": "Wire-contract version; bump only on breaking change." },
    "seq": { "type": "integer", "minimum": 0, "description": "Per-run monotonic logical cursor (after_seq resume)." },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "turn": { "type": ["integer", "null"], "minimum": 0 },
    "ts": { "type": "string", "format": "date-time", "description": "UTC, timezone-aware." },
    "type": {
      "type": "string",
      "enum": [
        "run_started",
        "turn_started",
        "text_delta",
        "reasoning_delta",
        "message_completed",
        "tool_started",
        "tool_progress",
        "tool_completed",
        "approval_request",
        "approval_resolved",
        "permission_mode_changed",
        "node_updated",
        "usage_delta",
        "heartbeat",
        "run_cancelled",
        "run_failed",
        "run_completed",
        "resync_required",
        "warning",
        "memory_written",
        "peer_started",
        "peer_ended",
        "tools_changed",
        "compact_started",
        "compact_applied",
        "user_message",
        "turn_completed"
      ]
    },
    "data": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "run_started" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/run_started" } } } },
    { "if": { "properties": { "type": { "const": "turn_started" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/turn_started" } } } },
    { "if": { "properties": { "type": { "const": "text_delta" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/text_delta" } } } },
    { "if": { "properties": { "type": { "const": "reasoning_delta" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/reasoning_delta" } } } },
    { "if": { "properties": { "type": { "const": "message_completed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/message_completed" } } } },
    { "if": { "properties": { "type": { "const": "tool_started" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/tool_started" } } } },
    { "if": { "properties": { "type": { "const": "tool_progress" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/tool_progress" } } } },
    { "if": { "properties": { "type": { "const": "tool_completed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/tool_completed" } } } },
    { "if": { "properties": { "type": { "const": "approval_request" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/approval_request" } } } },
    { "if": { "properties": { "type": { "const": "approval_resolved" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/approval_resolved" } } } },
    { "if": { "properties": { "type": { "const": "permission_mode_changed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/permission_mode_changed" } } } },
    { "if": { "properties": { "type": { "const": "node_updated" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/node_updated" } } } },
    { "if": { "properties": { "type": { "const": "usage_delta" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/usage_delta" } } } },
    { "if": { "properties": { "type": { "const": "heartbeat" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/heartbeat" } } } },
    { "if": { "properties": { "type": { "const": "run_cancelled" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/run_cancelled" } } } },
    { "if": { "properties": { "type": { "const": "run_failed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/run_failed" } } } },
    { "if": { "properties": { "type": { "const": "run_completed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/run_completed" } } } },
    { "if": { "properties": { "type": { "const": "resync_required" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/resync_required" } } } },
    { "if": { "properties": { "type": { "const": "warning" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/warning" } } } },
    { "if": { "properties": { "type": { "const": "memory_written" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/memory_written" } } } },
    { "if": { "properties": { "type": { "const": "peer_started" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/peer_started" } } } },
    { "if": { "properties": { "type": { "const": "peer_ended" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/peer_ended" } } } },
    { "if": { "properties": { "type": { "const": "tools_changed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/tools_changed" } } } },
    { "if": { "properties": { "type": { "const": "compact_started" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/compact_started" } } } },
    { "if": { "properties": { "type": { "const": "compact_applied" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/compact_applied" } } } },
    { "if": { "properties": { "type": { "const": "user_message" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/user_message" } } } },
    { "if": { "properties": { "type": { "const": "turn_completed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/turn_completed" } } } }
  ],
  "$defs": {
    "run_started": {
      "type": "object",
      "required": ["run_id"],
      "additionalProperties": false,
      "description": "Run accepted. policy_ref is an additive snapshot identity (P9/ADR-0045): resolved once at run creation and frozen for the whole run; A/B routes by fingerprint. Optional keeps v1 additive (no bump).",
      "properties": {
        "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policy_ref": {
          "type": "object",
          "required": ["id", "fingerprint"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "fingerprint": { "type": "string", "maxLength": 128 }
          }
        }
      }
    },
    "turn_started": {
      "type": "object",
      "required": ["turn"],
      "additionalProperties": false,
      "properties": { "turn": { "type": "integer", "minimum": 0 } }
    },
    "text_delta": {
      "type": "object",
      "required": ["delta"],
      "additionalProperties": false,
      "properties": {
        "delta": { "type": "string", "maxLength": 8192 },
        "item_id": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "reasoning_delta": {
      "type": "object",
      "required": ["delta"],
      "additionalProperties": false,
      "properties": { "delta": { "type": "string", "maxLength": 8192 } }
    },
    "message_completed": {
      "type": "object",
      "required": ["message_id"],
      "additionalProperties": false,
      "description": "A finalized message (D-P7-C option (1); ADR-0034). final_text is the bounded committed body so after_seq replay alone recovers text for every surface; oversized bodies set truncated (full text stays authoritative in checkpoint). Not logged (C20).",
      "properties": {
        "message_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "item_id": { "type": ["string", "null"], "maxLength": 128 },
        "final_text": { "type": "string", "maxLength": 8192 },
        "truncated": { "type": "boolean" }
      }
    },
    "tool_started": {
      "type": "object",
      "required": ["tool_call_id", "name", "capability", "risk", "args_summary"],
      "additionalProperties": false,
      "properties": {
        "tool_call_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "capability": { "type": "string", "enum": ["readonly", "write", "exec", "network", "memory"] },
        "risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "args_summary": { "type": "string", "maxLength": 8192 }
      }
    },
    "tool_progress": {
      "type": "object",
      "required": ["message"],
      "additionalProperties": false,
      "properties": { "message": { "type": "string", "maxLength": 8192 } }
    },
    "tool_completed": {
      "type": "object",
      "required": ["tool_call_id", "status"],
      "additionalProperties": false,
      "properties": {
        "tool_call_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["success", "error", "critical_error", "timed_out", "cancelled", "denied"] },
        "preview": { "type": "string", "maxLength": 4096, "description": "Bounded tool-output preview for the card (C18/ADR-0019). Never the full text; read full body via artifact_ref. Not logged (C20)." },
        "artifact_ref": { "type": ["string", "null"], "maxLength": 128, "description": "Opaque artifact:// pointer for the full output when archived. Never an absolute path." },
        "truncated": { "type": "boolean", "description": "True when preview was cut or the full body lives behind artifact_ref." }
      }
    },
    "approval_request": {
      "type": "object",
      "required": ["request_id", "tool_call_id", "name", "args_summary", "risk", "reason", "expires_at"],
      "additionalProperties": false,
      "properties": {
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tool_call_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "args_summary": { "type": "string", "maxLength": 8192 },
        "risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "reason": { "type": "string", "maxLength": 8192 },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "approval_resolved": {
      "type": "object",
      "required": ["request_id", "tool_call_id", "decision", "decided_by", "resolved_at"],
      "additionalProperties": false,
      "properties": {
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tool_call_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "decision": { "type": "string", "enum": ["allow", "deny"] },
        "decided_by": { "type": "string", "maxLength": 128 },
        "resolved_at": { "type": "string", "format": "date-time" }
      }
    },
    "permission_mode_changed": {
      "type": "object",
      "required": ["mode", "changed_by", "effective_from_turn"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["default", "plan", "full_auto"] },
        "changed_by": { "type": "string", "maxLength": 128 },
        "effective_from_turn": { "type": "integer", "minimum": 0 }
      }
    },
    "node_updated": {
      "type": "object",
      "description": "Task-tree node projection (DAG belongs to P8; no producer yet). P7 T11 additive-shaped to a bounded whitelist (C18/C13): node identity/status only, never payload.",
      "required": ["node_id", "status"],
      "additionalProperties": false,
      "properties": {
        "node_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "maxLength": 64 },
        "title": { "type": ["string", "null"], "maxLength": 256 },
        "parent_id": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "usage_delta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "run_cancelled": {
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "properties": { "reason": { "type": "string", "maxLength": 8192 } }
    },
    "run_failed": {
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string", "maxLength": 128 },
            "message": { "type": "string", "maxLength": 8192 },
            "retryable": { "type": "boolean" }
          }
        }
      }
    },
    "run_completed": {
      "type": "object",
      "required": ["usage"],
      "additionalProperties": false,
      "properties": {
        "usage": { "type": "object" },
        "exit_reason": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "resync_required": {
      "type": "object",
      "required": ["reason", "expected", "current"],
      "additionalProperties": false,
      "properties": {
        "reason": { "type": "string", "maxLength": 8192 },
        "expected": { "type": "integer", "minimum": 1 },
        "current": { "type": "integer", "minimum": 1 }
      }
    },
    "warning": {
      "type": "object",
      "required": ["message"],
      "additionalProperties": false,
      "properties": { "message": { "type": "string", "maxLength": 8192 } }
    },
    "memory_written": {
      "type": "object",
      "required": ["kind", "chunk_count"],
      "additionalProperties": false,
      "description": "Bounded memory-write acknowledgement (ADR-0024/0026): condensed facts only, never raw text; oversized content is referenced via artifact_ref.",
      "properties": {
        "kind": { "type": "string", "enum": ["core", "daily", "distill"] },
        "chunk_count": { "type": "integer", "minimum": 0 },
        "source": { "type": ["string", "null"], "maxLength": 64 },
        "artifact_ref": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "peer_started": {
      "type": "object",
      "required": ["parent_run_id", "child_run_id", "node_id"],
      "additionalProperties": false,
      "description": "Parent spawned a child agent run (P8; ADR-0042). Correlation keys only, never payload.",
      "properties": {
        "parent_run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "child_run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "node_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "peer_ended": {
      "type": "object",
      "required": ["parent_run_id", "child_run_id", "node_id", "terminal_status"],
      "additionalProperties": false,
      "description": "Child agent run reached a terminal state, reported to parent (P8; ADR-0042). result_ref is an opaque artifact pointer, never the body (C18/C20).",
      "properties": {
        "parent_run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "child_run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "node_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "terminal_status": { "type": "string", "enum": ["completed", "failed", "cancelled"] },
        "result_ref": { "type": ["string", "null"], "maxLength": 128 },
        "resumable_hint": { "type": "boolean" }
      }
    },
    "tools_changed": {
      "type": "object",
      "required": ["domain"],
      "additionalProperties": false,
      "description": "Capability roster changed (P9/ADR-0046): live-only advisory, no payload; consumers re-fetch the roster for future runs. Not persisted, never logged (C20).",
      "properties": { "domain": { "type": "string", "enum": ["tools", "skills", "mcp", "plugins", "settings"] } }
    },
    "compact_started": {
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "description": "Kernel began recoverable context compaction at a turn boundary (P10/ADR-0048, design/02 §10). reason is a short kernel label; no payload, never the summary text (C18/C20).",
      "properties": { "reason": { "type": "string", "maxLength": 128 } }
    },
    "compact_applied": {
      "type": "object",
      "required": ["baseline_seq", "covered_from", "covered_to", "summary_bytes"],
      "additionalProperties": false,
      "description": "Compaction applied; baseline_seq is the durable seq that rewrote context so renderers re-fold their view (design/02 §10). covered_from/covered_to are the evicted durable event seq range (originals read back from append-only event_log); summary_bytes is the summary size only, never its text (C20).",
      "properties": {
        "baseline_seq": { "type": "integer", "minimum": 0 },
        "covered_from": { "type": "integer", "minimum": 0 },
        "covered_to": { "type": "integer", "minimum": 0 },
        "summary_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "user_message": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "description": "User-originated message body persisted into the fact stream (B1; design §4.2). text is the bounded user-originated text (maxLength = OutputBudget.model_result_bytes; injected scaffolding stripped before persisting); truncated=true when the stored body was cut. Full body stays authoritative in the checkpoint. Not logged (C20).",
      "properties": {
        "text": { "type": "string", "maxLength": 16384 },
        "truncated": { "type": "boolean" }
      }
    },
    "turn_completed": {
      "type": "object",
      "additionalProperties": false,
      "description": "Turn boundary (B6; design §5.1 Stop point). usage is the base token usage object; interrupted is the Interrupt point's verdict. No message body is carried (C18/C20).",
      "properties": {
        "usage": { "type": "object" },
        "interrupted": { "type": "boolean" }
      }
    }
  }
}
