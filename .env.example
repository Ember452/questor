# Questor 配置模板 — 复制为 .env 并填值；切勿提交真实凭据。

# 模型网关 (LiteLLM) — BYOM，填任一家即可
LITELLM_API_BASE=
LITELLM_API_KEY=
QUESTOR_MODEL=            # 例 deepseek/deepseek-chat、openai/gpt-4o-mini、anthropic/claude-...

# 可选：直连某 provider 的 key（LiteLLM 也认）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# 运行
QUESTOR_DATA_DIR=         # 默认 ~/.questor
QUESTOR_WEB_PORT=         # 本地事件服务端口（桌面 sidecar 会自选）

# 可观测/加固（后期）
QUESTOR_LOG_LEVEL=info
