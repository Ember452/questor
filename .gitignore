# 本地一次性/临时脚本（下划线前缀 = scratch，不入库）
scripts/_*
# 例外：共用守卫 kit 是入库资产（新守卫必须复用它；不要再靠 `git add -f`）。
!scripts/_guard_kit.py
!scripts/__init__.py
